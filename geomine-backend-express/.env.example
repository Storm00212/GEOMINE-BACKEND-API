# Postgres connection string — same database the old geomine-backend uses.
DATABASE_URL=postgresql://user:password@localhost:5432/geomine

# JWT signing secret for access tokens — must match the old backend's if you
# want tokens issued by one to be accepted by the other.
JWT_SECRET=change-me-in-production

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Optional — defaults to 4000 (same port as the old backend) if unset.
PORT=4000
